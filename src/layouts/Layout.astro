---
import '../styles/global.css';
import themeInit from '../scripts/theme-init.ts?raw';
import geistLatinUrl from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import type { Messages } from '../i18n/messages/types';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import AnnouncementBar from '../components/site/AnnouncementBar.astro';
import { withBase } from '../lib/paths';

interface Props {
  lang: string;
  title: string;
  description: string;
  messages: Messages;
  alternatePath?: string;
  alternateLabel?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  ogImage?: string;
  breadcrumb?: Array<{ name: string; url?: string }>;
}

const {
  lang,
  title,
  description,
  messages,
  alternatePath = '/',
  alternateLabel = 'English',
  ogType = 'website',
  publishedTime,
  modifiedTime,
  ogImage: ogImageProp,
  breadcrumb
} = Astro.props;

const site = Astro.site ?? new URL('https://domaincraft.github.io/domaincraft-site/');
const canonical = new URL(Astro.url.pathname, site).href;
const altPath = withBase(alternatePath);
const alternate = new URL(altPath, site).href;
const alternateLang = lang === 'en' ? 'ru' : 'en';
const ogImage = new URL(withBase(ogImageProp ?? '/og-image.png'), site).href;
const ogLocale = lang === 'ru' ? 'ru_RU' : 'en_US';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="preload" href={geistLatinUrl} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={lang === 'en' ? canonical : alternate} />
    <link rel="alternate" hreflang="ru" href={lang === 'ru' ? canonical : alternate} />
    <link rel="alternate" hreflang="x-default" href={lang === 'en' ? canonical : alternate} />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="DomainCraft" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={description} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={description} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(
      ogType === 'article' && publishedTime
        ? {
            '@context': 'https://schema.org',
            '@type': 'Article',
            headline: title,
            description,
            inLanguage: lang,
            datePublished: publishedTime,
            dateModified: modifiedTime ?? publishedTime,
            mainEntityOfPage: canonical,
            image: ogImage,
            author: { '@type': 'Organization', name: 'DomainCraft' },
            publisher: { '@type': 'Organization', name: 'DomainCraft' }
          }
        : breadcrumb && breadcrumb.length > 0
          ? {
              '@context': 'https://schema.org',
              '@type': 'BreadcrumbList',
              itemListElement: breadcrumb.map((item, i) => ({
                '@type': 'ListItem',
                position: i + 1,
                name: item.name,
                ...(item.url ? { item: new URL(withBase(item.url), site).href } : {})
              }))
            }
          : {
            '@context': 'https://schema.org',
            '@type': 'SoftwareApplication',
            name: 'DomainCraft',
            applicationCategory: 'DeveloperApplication',
            operatingSystem: 'Windows, macOS, Linux',
            description,
            url: canonical,
            image: ogImage,
            offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
            author: { '@type': 'Organization', name: 'DomainCraft' }
          }
    )} />
    <script is:inline set:html={themeInit}></script>
    <title>{title}</title>
  </head>
  <body class="min-h-dvh bg-background font-sans antialiased selection:bg-primary selection:text-primary-foreground">
    <AnnouncementBar messages={messages.announcementBar} />
    <Header
      lang={lang}
      messages={messages}
      alternateHref={altPath}
      alternateLabel={alternateLabel}
      alternateLang={alternateLang}
    />
    <main>
      <slot />
    </main>
    <Footer lang={lang} messages={messages} alternateHref={altPath} alternateLabel={alternateLabel} alternateLang={alternateLang} />
  </body>
</html>
