---
import '../styles/global.css';
import themeInit from '../scripts/theme-init.ts?raw';
import type { Messages } from '../i18n/messages/types';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';

interface Props {
  lang: string;
  title: string;
  description: string;
  messages: Messages;
  alternatePath?: string;
  alternateLabel?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  lang,
  title,
  description,
  messages,
  alternatePath = '/',
  alternateLabel = 'English',
  ogType = 'website',
  publishedTime,
  modifiedTime
} = Astro.props;

const site = Astro.site ?? new URL('https://domaincraft.dev/');
const canonical = new URL(Astro.url.pathname, site).href;
const alternate = new URL(alternatePath, site).href;
const alternateLang = lang === 'en' ? 'ru' : 'en';
const ogImage = new URL('/og-image.png', site).href;
const ogLocale = lang === 'ru' ? 'ru_RU' : 'en_US';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={lang === 'en' ? canonical : alternate} />
    <link rel="alternate" hreflang="ru" href={lang === 'ru' ? canonical : alternate} />
    <link rel="alternate" hreflang="x-default" href={lang === 'en' ? canonical : alternate} />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="DomainCraft" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline set:html={themeInit}></script>
    <title>{title}</title>
  </head>
  <body class="min-h-dvh bg-background font-sans antialiased selection:bg-primary selection:text-primary-foreground">
    <Header
      lang={lang}
      messages={messages}
      alternateHref={alternatePath}
      alternateLabel={alternateLabel}
      alternateLang={alternateLang}
    />
    <main>
      <slot />
    </main>
    <Footer lang={lang} messages={messages} alternateHref={alternatePath} alternateLabel={alternateLabel} alternateLang={alternateLang} />
  </body>
</html>
