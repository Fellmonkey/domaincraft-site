---
import Layout from './Layout.astro';
import { getMessages } from '../i18n';

interface DocItem {
  slug: string;
  title: string;
}

interface DocGroup {
  label: string;
  items: DocItem[];
}

interface Props {
  lang: 'en' | 'ru';
  title: string;
  description: string;
  docsRoot: string;
  groups: DocGroup[];
  currentSlug: string;
  sectionLabel: string;
  prev?: DocItem | null;
  next?: DocItem | null;
}

const { lang, title, description, docsRoot, groups, currentSlug, sectionLabel, prev, next } = Astro.props;
const messages = getMessages(lang);
const editBase = 'https://github.com/DomainCraft/DomainCraftSite/blob/main/src/content/docs';
---

<Layout lang={lang} title={title} description={description} messages={messages}>
  <div class="mx-auto grid w-full max-w-6xl gap-10 px-4 py-10 sm:px-6 lg:grid-cols-[220px_minmax(0,1fr)]">
    <nav class="docs-sidebar lg:sticky lg:top-20 lg:h-[calc(100dvh-6rem)] lg:overflow-y-auto lg:self-start" aria-label="Documentation">
      <details class="rounded-lg border border-border bg-card lg:hidden">
        <summary class="cursor-pointer px-4 py-3 text-sm font-medium">☰ {sectionLabel}</summary>
        <div class="space-y-4 border-t border-border p-4">
          {
            groups.map((group) => (
              <div key={group.label}>
                <p class="mb-1 text-xs font-semibold uppercase tracking-wider text-muted-foreground">{group.label}</p>
                <ul class="space-y-0.5">
                  {group.items.map((item) => (
                    <li key={item.slug}>
                      <a
                        href={`${docsRoot}/${item.slug}`}
                        class={`block rounded-md px-2 py-1.5 text-sm ${
                          item.slug === currentSlug ? 'font-medium text-primary' : 'text-muted-foreground'
                        }`}
                      >
                        {item.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </details>

      <div class="hidden space-y-6 lg:block">
        {
          groups.map((group) => (
            <div key={group.label}>
              <p class="mb-2 px-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground">{group.label}</p>
              <ul class="space-y-0.5">
                {group.items.map((item) => (
                  <li key={item.slug}>
                    <a
                      href={`${docsRoot}/${item.slug}`}
                      aria-current={item.slug === currentSlug ? 'page' : undefined}
                      class={`block rounded-md px-2 py-1.5 text-sm transition-colors ${
                        item.slug === currentSlug
                          ? 'bg-primary/10 font-medium text-primary'
                          : 'text-muted-foreground hover:bg-muted hover:text-foreground'
                      }`}
                    >
                      {item.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </nav>

    <article class="min-w-0">
      {
        lang !== 'en' && (
          <p class="mb-6 rounded-lg border border-border bg-card px-4 py-3 text-sm text-muted-foreground">
            Русский перевод документации в работе — содержимое пока на английском.
          </p>
        )
      }
      <p class="text-sm text-muted-foreground">{sectionLabel}</p>
      <h1 class="mt-1 text-balance text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h1>
      <p class="mt-3 text-balance text-muted-foreground">{description}</p>

      <div class="doc-content mt-8 border-t border-border pt-8">
        <slot />
      </div>

      <div class="mt-12 flex items-center justify-between gap-4 border-t border-border pt-6 text-sm">
        {prev ? <a href={`${docsRoot}/${prev.slug}`} class="text-muted-foreground transition-colors hover:text-foreground">← {prev.title}</a> : <span />}
        {next ? <a href={`${docsRoot}/${next.slug}`} class="ml-auto text-right text-muted-foreground transition-colors hover:text-foreground">{next.title} →</a> : <span />}
      </div>

      <p class="mt-8 text-xs text-muted-foreground">
        <a href={`${editBase}/${currentSlug}.md`} target="_blank" rel="noreferrer" class="underline underline-offset-4 hover:text-foreground">
          {lang === 'en' ? 'Edit this page on GitHub' : 'Редактировать эту страницу на GitHub'}
        </a>
      </p>
    </article>
  </div>
</Layout>

<style is:global>
  .doc-content {
    line-height: 1.75;
    font-size: 0.9375rem;
  }  .doc-content h2 {
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .doc-content h3 {
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    font-size: 1.0625rem;
    font-weight: 600;
  }
  .doc-content p {
    margin-bottom: 1rem;
    color: var(--muted-foreground);
  }
  .doc-content ul,
  .doc-content ol {
    margin-bottom: 1rem;
    padding-left: 1.25rem;
    color: var(--muted-foreground);
  }
  .doc-content ul {
    list-style: disc;
  }
  .doc-content ol {
    list-style: decimal;
  }
  .doc-content li {
    margin-bottom: 0.375rem;
  }
  .doc-content li > ul,
  .doc-content li > ol {
    margin-top: 0.375rem;
    margin-bottom: 0;
  }
  .doc-content a {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .doc-content a:hover {
    text-decoration-thickness: 2px;
  }
  .doc-content strong {
    color: var(--foreground);
    font-weight: 600;
  }
  .doc-content code {
    font-family: var(--font-mono);
    font-size: 0.8125em;
    background: var(--muted);
    border-radius: 0.375rem;
    padding: 0.125rem 0.375rem;
  }
  .doc-content pre {
    margin-bottom: 1.25rem;
    overflow-x: auto;
    border-radius: 0.75rem;
    border: 1px solid var(--border);
    background: var(--card);
    padding: 1rem;
    font-size: 0.8125rem;
    line-height: 1.7;
  }
  .doc-content pre code {
    background: transparent;
    padding: 0;
    font-size: inherit;
  }
  .doc-content table {
    margin-bottom: 1.25rem;
    width: 100%;
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  .doc-content th {
    text-align: left;
    font-weight: 600;
    color: var(--foreground);
    border-bottom: 1px solid var(--border);
    padding: 0.5rem 0.75rem;
  }
  .doc-content td {
    border-bottom: 1px solid var(--border);
    padding: 0.5rem 0.75rem;
    color: var(--muted-foreground);
  }
  .doc-content tr:last-child td {
    border-bottom: none;
  }
  .doc-content blockquote {
    border-left: 3px solid var(--primary);
    padding-left: 1rem;
    margin-bottom: 1rem;
    color: var(--muted-foreground);
    font-style: italic;
  }
  .doc-content hr {
    border-color: var(--border);
    margin: 2rem 0;
  }

  /* Scrollbars */
  .docs-sidebar,
  .doc-content pre,
  .doc-content table {
    scrollbar-width: thin;
    scrollbar-color: color-mix(in oklch, var(--muted-foreground) 35%, transparent) transparent;
  }
  .docs-sidebar::-webkit-scrollbar,
  .doc-content pre::-webkit-scrollbar,
  .doc-content table::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }
  .docs-sidebar::-webkit-scrollbar-track,
  .doc-content pre::-webkit-scrollbar-track,
  .doc-content table::-webkit-scrollbar-track {
    background: transparent;
  }
  .docs-sidebar::-webkit-scrollbar-thumb,
  .doc-content pre::-webkit-scrollbar-thumb,
  .doc-content table::-webkit-scrollbar-thumb {
    background: color-mix(in oklch, var(--muted-foreground) 35%, transparent);
    border-radius: 9999px;
  }
  .docs-sidebar::-webkit-scrollbar-thumb:hover,
  .doc-content pre::-webkit-scrollbar-thumb:hover,
  .doc-content table::-webkit-scrollbar-thumb:hover {
    background: color-mix(in oklch, var(--muted-foreground) 55%, transparent);
  }
</style>