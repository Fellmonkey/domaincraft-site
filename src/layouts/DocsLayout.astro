---
import Layout from './Layout.astro';
import Prose from '../components/Prose.astro';
import { getMessages } from '../i18n';
import { withBase } from '../lib/paths';

interface DocItem {
  slug: string;
  title: string;
}

interface DocGroup {
  label: string;
  items: DocItem[];
}

interface Props {
  lang: 'en' | 'ru';
  title: string;
  description: string;
  docsRoot: string;
  groups: DocGroup[];
  currentSlug: string;
  sectionLabel: string;
  prev?: DocItem | null;
  next?: DocItem | null;
  breadcrumb?: Array<{ name: string; url?: string }>;
}

const { lang, title, description, docsRoot, groups, currentSlug, sectionLabel, prev, next, breadcrumb } = Astro.props;
const messages = getMessages(lang);
const editBase = 'https://github.com/DomainCraft/domaincraft-site/blob/main/src/content/docs';
const root = withBase(docsRoot);
const alternatePath = lang === 'en' ? `/ru/docs/${currentSlug}` : `/docs/${currentSlug}`;
const alternateLabel = lang === 'en' ? 'Русский' : 'English';
---

<Layout lang={lang} title={title} description={description} messages={messages} alternatePath={alternatePath} alternateLabel={alternateLabel} breadcrumb={breadcrumb}>
  <div class="mx-auto grid w-full max-w-6xl grid-cols-1 gap-10 px-4 py-10 sm:px-6 lg:grid-cols-[220px_minmax(0,1fr)]">
    <nav class="docs-sidebar lg:sticky lg:top-20 lg:h-[calc(100dvh-6rem)] lg:overflow-y-auto lg:self-start" aria-label="Documentation">
      <details class="rounded-lg border border-border bg-card lg:hidden">
        <summary class="cursor-pointer px-4 py-3 text-sm font-medium">☰ {sectionLabel}</summary>
        <div class="space-y-4 border-t border-border p-4">
          {
            groups.map((group) => (
              <div>
                <p class="mb-1 text-xs font-semibold uppercase tracking-wider text-muted-foreground">{group.label}</p>
                <ul class="space-y-0.5">
                  {group.items.map((item) => (
                    <li>
                      <a
                        href={`${root}/${item.slug}`}
                        class={`block rounded-md px-2 py-1.5 text-sm ${
                          item.slug === currentSlug ? 'font-medium text-primary' : 'text-muted-foreground'
                        }`}
                      >
                        {item.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </details>

      <div class="hidden space-y-6 lg:block">
        {
          groups.map((group) => (
            <div>
              <p class="mb-2 px-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground">{group.label}</p>
              <ul class="space-y-0.5">
                {group.items.map((item) => (
                  <li>
                    <a
                      href={`${root}/${item.slug}`}
                      aria-current={item.slug === currentSlug ? 'page' : undefined}
                      class={`block rounded-md px-2 py-1.5 text-sm transition-colors ${
                        item.slug === currentSlug
                          ? 'bg-primary/10 font-medium text-primary'
                          : 'text-muted-foreground hover:bg-muted hover:text-foreground'
                      }`}
                    >
                      {item.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </nav>

    <article class="min-w-0">
      {
        lang !== 'en' && (
          <p class="mb-6 rounded-lg border border-border bg-card px-4 py-3 text-sm text-muted-foreground">
            Русский перевод документации в работе — содержимое пока на английском.
          </p>
        )
      }
      <p class="text-sm text-muted-foreground">{sectionLabel}</p>
      <h1 class="mt-1 text-balance text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h1>
      <p class="mt-3 text-balance text-muted-foreground">{description}</p>

      <div class="mt-8 border-t border-border pt-8">
        <Prose>
          <slot />
        </Prose>
      </div>

      <div class="mt-12 flex items-center justify-between gap-4 border-t border-border pt-6 text-sm">
        {prev ? <a href={`${root}/${prev.slug}`} class="text-muted-foreground transition-colors hover:text-foreground">← {prev.title}</a> : <span />}
        {next ? <a href={`${root}/${next.slug}`} class="ml-auto text-right text-muted-foreground transition-colors hover:text-foreground">{next.title} →</a> : <span />}
      </div>

      <p class="mt-8 text-xs text-muted-foreground">
        <a href={`${editBase}/${currentSlug}.md`} target="_blank" rel="noreferrer" class="underline underline-offset-4 hover:text-foreground">
          {lang === 'en' ? 'Edit this page on GitHub' : 'Редактировать эту страницу на GitHub'}
        </a>
      </p>
    </article>
  </div>
</Layout>

<style is:global>
  /* Scrollbars (docs sidebar only; prose scrollbars live in Prose.astro) */
  .docs-sidebar {
    scrollbar-width: thin;
    scrollbar-color: color-mix(in oklch, var(--muted-foreground) 35%, transparent) transparent;
  }
  .docs-sidebar::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }
  .docs-sidebar::-webkit-scrollbar-track {
    background: transparent;
  }
  .docs-sidebar::-webkit-scrollbar-thumb {
    background: color-mix(in oklch, var(--muted-foreground) 35%, transparent);
    border-radius: 9999px;
  }
  .docs-sidebar::-webkit-scrollbar-thumb:hover {
    background: color-mix(in oklch, var(--muted-foreground) 55%, transparent);
  }
</style>