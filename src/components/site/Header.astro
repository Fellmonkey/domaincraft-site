---
import type { Messages } from '../../i18n/messages/types';
import ThemeToggle from '../ThemeToggle';
import LocaleSwitcher from '../LocaleSwitcher';
import { Button } from '../../components/ui/button';
import { Badge } from '../../components/ui/badge';

interface Props {
  lang: string;
  messages: Messages;
  alternateHref: string;
  alternateLabel: string;
  alternateLang: string;
}

const { lang, messages } = Astro.props;

const isRoot = lang === 'en';
const currentLabel = lang === 'en' ? 'English' : 'Русский';
const currentHref = lang === 'en' ? '/' : '/ru/';
const options = [
  { code: 'en', label: 'English', href: lang === 'en' ? currentHref : '/' },
  { code: 'ru', label: 'Русский', href: lang === 'ru' ? currentHref : '/ru/' }
];

const navLinks = [
  { label: messages.nav.features, href: isRoot ? '#features' : '/ru/#features' },
  { label: messages.nav.howItWorks, href: isRoot ? '#how-it-works' : '/ru/#how-it-works' },
  { label: messages.nav.bridges, href: isRoot ? '#bridges' : '/ru/#bridges' },
  { label: messages.nav.ai, href: isRoot ? '#ai' : '/ru/#ai' },
  { label: messages.nav.studio, href: isRoot ? '/studio' : '/ru/studio' }
];
---

<header class="sticky top-0 z-40 border-b border-border bg-background/80 backdrop-blur supports-[backdrop-filter]:bg-background/60">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-4 sm:px-6">
    <a href={lang === 'en' ? '/' : '/ru/'} class="flex shrink-0 items-center gap-2 font-semibold" aria-label="DomainCraft">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z" fill="var(--color-primary)" />
      </svg>
      <span class="text-base tracking-tight">DomainCraft</span>
      <Badge variant="outline" class="hidden sm:inline-flex">OSS</Badge>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
      {
        navLinks.map((l) => (
          <a
            href={l.href}
            class="rounded-md px-3 py-2 text-sm text-muted-foreground transition-colors hover:text-foreground"
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-1.5">
      <a
        href="https://github.com/DomainCraft/DomainCraft"
        target="_blank"
        rel="noreferrer"
        class="hidden items-center gap-2 rounded-md px-2 py-2 text-sm text-muted-foreground transition-colors hover:text-foreground md:flex"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.02-.02-2-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.59.23 2.76.11 3.05.74.8 1.18 1.83 1.18 3.09 0 4.43-2.69 5.41-5.25 5.7.41.35.77 1.05.77 2.11 0 1.53-.01 2.76-.01 3.14 0 .31.2.68.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
        </svg>
        <span class="hidden lg:inline">{messages.nav.star}</span>
      </a>
      <a href="#install" class="hidden md:inline-flex">
        <Button size="sm" variant="outline">{messages.nav.install}</Button>
      </a>
      <ThemeToggle client:load />
      <LocaleSwitcher client:load lang={lang} currentLabel={currentLabel} options={options} />
    </div>
  </div>
</header>