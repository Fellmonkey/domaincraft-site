---
import type { Messages } from '../../i18n/messages/types';
import { withBase } from '../../lib/paths';

interface Props {
  lang: string;
  messages: Messages;
  alternateHref: string;
  alternateLabel: string;
  alternateLang: string;
}

const { lang, messages, alternateHref, alternateLabel } = Astro.props;
const isRoot = lang === 'en';
const year = new Date().getFullYear();
const rights = messages.footer.rights.replace('{year}', String(year));

const columns = [
  { title: messages.footer.product, links: Object.entries(messages.footer.productLinks) },
  { title: messages.footer.resources, links: Object.entries(messages.footer.resourcesLinks) }
];

function footerHref(key: string, isRoot: boolean): string {
  const prefix = isRoot ? '' : '/ru';
  if (key === 'github') return 'https://github.com/DomainCraft/DomainCraft';
  if (key === 'docs') return withBase(`${prefix}/docs/getting-started/quickstart`);
  if (key === 'generate') return isRoot ? '#install' : withBase('/ru/#install');
  if (key === 'bridges') return withBase(`${prefix}/bridges`);
  if (key === 'skills') return withBase(`${prefix}/skills`);
  if (key === 'studio') return withBase(`${prefix}/studio`);
  if (key === 'changelog') return withBase(`${prefix}/changelog`);
  if (key === 'blog') return withBase(`${prefix}/blog`);
  return withBase(`${prefix}/#`);
}
---

<footer class="border-t border-border">
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-4 py-14 sm:px-6 lg:grid-cols-[1.4fr_1fr_1fr]">
    <div class="space-y-4">
      <a href={withBase(isRoot ? '/' : '/ru/')} class="flex items-center gap-2">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z" fill="var(--color-primary)" />
        </svg>
        <span class="font-semibold">DomainCraft</span>
      </a>
      <p class="max-w-xs text-sm text-muted-foreground">{messages.footer.tagline}</p>
    </div>

    {
      columns.map((col) => (
        <nav aria-label={col.title}>
          <h3 class="mb-3 text-sm font-semibold">{col.title}</h3>
          <ul class="space-y-2">
            {col.links.map(([key, label]) => (
              <li>
                <a href={footerHref(key, isRoot)} class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div class="border-t border-border">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-4 py-6 text-sm text-muted-foreground sm:flex-row sm:px-6">
      <p>{rights}</p>
      <p>
        <a href={alternateHref} class="underline underline-offset-4 hover:text-foreground">
          {alternateLabel}
        </a>
      </p>
    </div>
  </div>
</footer>