---
import type { AiMessages } from '../../i18n/messages/types';
import CopyButton from '../CopyButton';
import { Badge } from '../../components/ui/badge';

interface Props {
  messages: AiMessages;
}

const { messages } = Astro.props;

const prompt =
`You are modeling an online store with DomainCraft.
Define two entities, Product and Category, with:
- relations, audit + soft_delete features
- permissions: public read, Admin create/delete, @Owner update
Output only a valid domain.yaml. I'll run domaincraft generate.`;

const resultYaml = `product: Product
features: [audit, soft_delete]
fields:
  id: uuid [primary]
  title: string [required, min:3]
  price: decimal [required, gte:0]
permissions:
  read: ["*"]
  create: [Admin]
  update: ["@Owner", Admin]
→ 42 files · C# ASP.NET Core · Docker · tests`;
---

<section id="ai" class="relative overflow-hidden scroll-mt-24 border-y border-border bg-muted/30">
  <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_center,rgba(249,115,22,0.08),transparent_60%)]" aria-hidden="true" />
  <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <div class="mx-auto mb-12 max-w-3xl text-center">
      <Badge variant="outline" className="mb-3 font-mono text-xs">{messages.eyebrow} · {messages.label}</Badge>
      <h2 class="text-balance text-3xl font-semibold tracking-tight sm:text-4xl">
        {messages.titleStart} <span class="text-primary">{messages.titleHighlight}</span>{messages.titleEnd}
      </h2>
      <p class="mt-4 text-pretty text-lg text-muted-foreground">{messages.subtitle}</p>
    </div>

    <div class="grid items-start gap-8 lg:grid-cols-2">
      <div class="space-y-4">
        {messages.cards.map((card, i) => (
          <article class="flex gap-4 rounded-xl border border-border bg-card p-5">
            <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-primary/10 font-mono text-sm font-semibold text-primary">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class="mb-1 text-base font-semibold">{card.title}</h3>
              <p class="text-sm text-muted-foreground">{card.description}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="space-y-4">
        <div class="rounded-xl border border-border bg-card">
          <div class="flex items-center justify-between gap-2 border-b border-border px-4 py-2.5">
            <span class="font-mono text-xs text-muted-foreground">{messages.promptLabel}</span>
            <CopyButton client:load value={prompt} label={messages.copyPrompt} copiedLabel={messages.copied} />
          </div>
          <p class="p-4 font-mono text-[13px] leading-relaxed text-foreground/90">{prompt}</p>
        </div>

        <div class="rounded-xl border border-border bg-card">
          <div class="flex items-center justify-between gap-2 border-b border-border px-4 py-2.5">
            <span class="font-mono text-xs text-muted-foreground">{messages.resultLabel}</span>
          </div>
          <pre class="overflow-x-auto p-4 font-mono text-[13px] leading-relaxed text-foreground/90">{resultYaml}</pre>
        </div>
      </div>
    </div>
  </div>
</section>