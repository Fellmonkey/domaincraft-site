---
import type { AiMessages } from '../../i18n/messages/types';
import AiSession from '../AiSession';
import { Badge } from '../../components/ui/badge';

interface Props {
  messages: AiMessages;
}

const { messages } = Astro.props;
---

<section id="ai" class="relative overflow-hidden scroll-mt-24 border-y border-border bg-muted/30">
  <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_center,rgba(249,115,22,0.08),transparent_60%)]" aria-hidden="true" />
  <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <div class="mx-auto mb-12 max-w-3xl text-center">
      <Badge variant="outline" className="mb-3 font-mono text-xs">{messages.eyebrow} · {messages.label}</Badge>
      <h2 class="text-balance text-3xl font-semibold tracking-tight sm:text-4xl">
        {messages.titleStart} <span class="text-primary">{messages.titleHighlight}</span>{messages.titleEnd}
      </h2>
      <p class="mt-4 text-pretty text-lg text-muted-foreground">{messages.subtitle}</p>
    </div>

    <div class="grid items-start gap-10 lg:grid-cols-2">
      <div class="space-y-4">
        {messages.cards.map((card, i) => (
          <article class="flex gap-4 rounded-xl border border-border bg-card p-5">
            <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-primary/10 font-mono text-sm font-semibold text-primary">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class="mb-1 text-base font-semibold">{card.title}</h3>
              <p class="text-sm text-muted-foreground">{card.description}</p>
            </div>
          </article>
        ))}
      </div>

      <AiSession
        client:load
        messages={{
          sessionTitle: messages.sessionTitle,
          copyPrompt: messages.copyPrompt,
          copied: messages.copied,
          stepYouAgent: messages.stepYouAgent,
          stepYaml: messages.stepYaml,
          stepGenerate: messages.stepGenerate,
          stepHooks: messages.stepHooks,
          stepDeploy: messages.stepDeploy,
          stepDeployResult: messages.stepDeployResult
        }}
      />
    </div>
  </div>
</section>
