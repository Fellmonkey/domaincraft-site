---
import type { AnnouncementBarMessages } from '../../i18n/messages/types';

interface Props {
  messages: AnnouncementBarMessages;
}

const { messages } = Astro.props;
---

<div class="border-b border-border bg-muted/40">
  <div class="mx-auto flex max-w-6xl items-center justify-center gap-x-3 gap-y-1 px-4 py-2 text-center sm:px-6">
    <span class="inline-flex items-center gap-2 rounded-full border border-primary/25 bg-primary/10 px-3.5 py-1 text-xs font-medium text-foreground">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
        <circle cx="9" cy="7" r="4" />
        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
      </svg>
      {messages.community}
    </span>
    <span class="text-xs text-muted-foreground" aria-hidden="true">·</span>
    <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-background px-3.5 py-1 text-xs text-muted-foreground">
      {messages.brand}
    </span>
  </div>
</div>
