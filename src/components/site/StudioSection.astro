---
import type { StudioMessages } from '../../i18n/messages/types';
import SectionHeading from './SectionHeading.astro';
import StudioMock from './StudioMock.astro';
import { Button } from '../../components/ui/button';

interface Props {
  lang: string;
  messages: StudioMessages;
}

const { lang, messages } = Astro.props;
const studioUrl = 'https://domaincraft.github.io/domaincraft-studio/';
---

<section id="studio" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-24 sm:px-6">
  <div class="grid items-center gap-12 lg:grid-cols-2">
    <div class="flex flex-col gap-6">
      <SectionHeading
        align="left"
        eyebrow={messages.eyebrow}
        titleStart={messages.titleStart}
        titleHighlight={messages.titleHighlight}
        titleEnd={messages.titleEnd}
        subtitle={messages.subtitle}
      />
      <ul class="space-y-3">
        {messages.bullets.map((b) => (
          <li key={b} class="flex items-center gap-3 text-sm text-muted-foreground">
            <span class="grid size-5 shrink-0 place-items-center rounded-full bg-primary/10 font-mono text-xs text-primary">✓</span>
            {b}
          </li>
        ))}
      </ul>
      <div class="flex flex-wrap gap-3">
        <a href={studioUrl} target="_blank" rel="noreferrer">
          <Button size="lg">{messages.primaryCta}</Button>
        </a>
        <a href="#install">
          <Button size="lg" variant="outline">{messages.secondaryCta}</Button>
        </a>
      </div>
    </div>

    <a
      href={studioUrl}
      target="_blank"
      rel="noreferrer"
      class="group relative block overflow-hidden rounded-xl border border-border bg-card"
      aria-label={messages.primaryCta}
    >
      <div class="flex items-center gap-2 border-b border-border bg-muted/40 px-4 py-2.5">
        <span class="flex gap-1.5" aria-hidden="true">
          <i class="size-2.5 rounded-full bg-red-400/80" />
          <i class="size-2.5 rounded-full bg-yellow-400/80" />
          <i class="size-2.5 rounded-full bg-green-400/80" />
        </span>
        <span class="font-mono text-xs text-muted-foreground">domaincraft-studio</span>
        <span class="ml-auto font-mono text-xs text-primary transition-transform group-hover:translate-x-0.5">↗</span>
      </div>
      <div class="aspect-[4/3] bg-[linear-gradient(to_right,hsl(var(--border)/0.6)_1px,transparent_1px),linear-gradient(to_bottom,hsl(var(--border)/0.6)_1px,transparent_1px)] bg-[size:1.5rem_1.5rem] p-6">
        <StudioMock />
      </div>
    </a>
  </div>
</section>
