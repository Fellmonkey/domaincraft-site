---
interface Props {
  name: string;
}

const { name } = Astro.props;
const s = 'var(--color-primary)';
---

<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke={s} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {
    name === 'shield' && (
      <>
        <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1 1 0 0 1 1.52 0C14.5 3.8 17 5 19 5a1 1 0 0 1 1 1z" />
        <path d="m9 12 2 2 4-4" />
      </>
    )
  }
  {
    name === 'key' && (
      <>
        <path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8" />
        <path d="M21 3v5h-5" />
        <path d="M9 11a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" />
      </>
    )
  }
  {
    name === 'refresh' && (
      <>
        <path d="M21 12a9 9 0 1 1-3-6.7" />
        <path d="M21 3v5h-5" />
      </>
    )
  }
  {
    name === 'blocks' && (
      <>
        <rect x="4" y="4" width="6" height="6" rx="1" />
        <rect x="14" y="4" width="6" height="6" rx="1" />
        <rect x="4" y="14" width="6" height="6" rx="1" />
        <rect x="14" y="14" width="6" height="6" rx="1" />
      </>
    )
  }
  {
    name === 'layout' && (
      <>
        <rect x="3" y="3" width="18" height="6" rx="1" />
        <rect x="3" y="11" width="9" height="10" rx="1" />
        <rect x="14" y="11" width="7" height="10" rx="1" />
      </>
    )
  }
  {
    name === 'infra' && <path d="M2 12h3l3-7 4 15 3-8h7" />
  }
</svg>