---
import type { TrustMessages } from '../../i18n/messages/types';

interface Props {
  messages: TrustMessages;
}

const { messages } = Astro.props;
---

<section class="border-y border-border bg-muted/30">
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <p class="mb-4 text-center text-xs font-medium uppercase tracking-widest text-muted-foreground">
      {messages.title}
    </p>
    <ul class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
      {messages.items.map((item) => (
        <li key={item} class="font-mono text-sm text-muted-foreground">{item}</li>
      ))}
    </ul>
  </div>
</section>
