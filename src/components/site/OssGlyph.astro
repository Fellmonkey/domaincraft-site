---
interface Props {
  name: string;
}

const { name } = Astro.props;
const s = 'var(--color-primary)';
---

<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke={s} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {
    name === 'license' && (
      <>
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10" />
        <path d="m9 12 2 2 4-4" />
      </>
    )
  }
  {
    name === 'contribute' && (
      <>
        <path d="M4 12h8M8 8l4 4-4 4" />
        <path d="M12 4h8v16h-8" />
      </>
    )
  }
  {
    name === 'roadmap' && (
      <>
        <circle cx="5" cy="6" r="2" />
        <circle cx="12" cy="12" r="2" />
        <circle cx="19" cy="6" r="2" />
        <path d="M5 8v6a2 2 0 0 0 2 2h5" />
        <path d="M19 8v6a2 2 0 0 1-2 2h-3" />
      </>
    )
  }
  {
    name === 'star' && <path d="M12 2 15.09 8.26 22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
  }
</svg>