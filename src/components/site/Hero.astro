---
import type { HeroMessages } from '../../i18n/messages/types';
import TerminalDemo from '../TerminalDemo';
import CopyButton from '../CopyButton';
import { Button } from '../../components/ui/button';
import { Badge } from '../../components/ui/badge';

interface Props {
  lang: string;
  messages: HeroMessages;
}

const { lang, messages } = Astro.props;
const installCmd = 'go install github.com/DomainCraft/DomainCraft/cmd/domaincraft@latest';
const studioHref = lang === 'en' ? '/studio' : '/ru/studio';
const generateHref = lang === 'en' ? '#install' : '/ru/#install';
---

<section class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(249,115,22,0.14),transparent_55%)]" />
    <div class="absolute inset-0 bg-[linear-gradient(to_right,hsl(var(--border)/0.5)_1px,transparent_1px),linear-gradient(to_bottom,hsl(var(--border)/0.5)_1px,transparent_1px)] bg-[size:3rem_3rem] [mask-image:radial-gradient(ellipse_at_top,black,transparent_70%)]" />
  </div>

  <div class="mx-auto max-w-6xl px-4 pt-20 pb-16 sm:px-6 sm:pt-28">
    <div class="grid items-center gap-14 lg:grid-cols-[1.05fr_1fr]">
      <div class="flex flex-col gap-6">
        <Badge variant="outline" class="w-fit font-mono text-xs">{messages.badge}</Badge>
        <h1 class="text-balance text-4xl font-semibold leading-tight tracking-tight sm:text-5xl lg:text-[3.4rem]">
          {messages.titleStart}{' '}
          <span class="bg-gradient-to-r from-primary to-primary/70 bg-clip-text text-transparent">
            {messages.titleHighlight}
          </span>{' '}
          {messages.titleEnd}
        </h1>
        <p class="max-w-xl text-pretty text-lg text-muted-foreground">{messages.subtitle}</p>
        <div class="flex flex-wrap items-center gap-3">
          <a href={generateHref}>
            <Button size="lg">{messages.primaryCta}</Button>
          </a>
          <a href={studioHref}>
            <Button size="lg" variant="outline">{messages.secondaryCta}</Button>
          </a>
        </div>
        <div class="flex w-fit max-w-full items-center gap-2 rounded-lg border border-border bg-card py-2 pl-4 pr-2">
          <code class="truncate font-mono text-xs text-muted-foreground sm:text-sm">{installCmd}</code>
          <CopyButton client:load value={installCmd} label="" copiedLabel={messages.copied} className="shrink-0" />
        </div>
      </div>

      <div class="relative">
        <TerminalDemo client:load messages={{
          terminalTitle: messages.terminalTitle,
          domainTab: messages.domainTab,
          codeTab: messages.codeTab,
          treeTab: messages.treeTab,
          running: messages.running,
          ready: messages.ready
        }} />
      </div>
    </div>
  </div>
</section>
