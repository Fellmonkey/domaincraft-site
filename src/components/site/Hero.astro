---
import type { HeroMessages } from '../../i18n/messages/types';
import TerminalDemo from '../TerminalDemo';
import { Button } from '../../components/ui/button';
import { Badge } from '../../components/ui/badge';
import { withBase } from '../../lib/paths';

interface Props {
  lang: string;
  messages: HeroMessages;
}

const { lang, messages } = Astro.props;
const releasesHref = 'https://github.com/DomainCraft/DomainCraft/releases';
const studioHref = withBase(lang === 'en' ? '/studio' : '/ru/studio');
const generateHref = lang === 'en' ? '#install' : withBase('/ru/#install');
---

<section class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(249,115,22,0.14),transparent_55%)]" />
    <div class="absolute inset-0 bg-[linear-gradient(to_right,hsl(var(--border)/0.5)_1px,transparent_1px),linear-gradient(to_bottom,hsl(var(--border)/0.5)_1px,transparent_1px)] bg-[size:3rem_3rem] [mask-image:radial-gradient(ellipse_at_top,black,transparent_70%)]" />
  </div>

  <div class="mx-auto max-w-6xl px-4 pt-10 pb-12 sm:px-6 sm:pt-20">
    <div class="grid grid-cols-1 items-center gap-10 sm:gap-14 lg:grid-cols-[1.05fr_1fr]">
      <div class="flex flex-col gap-6">
        <Badge variant="outline" className="w-fit font-mono text-xs">{messages.badge}</Badge>
        <h1 class="text-balance text-3xl font-semibold leading-tight tracking-tight sm:text-5xl lg:text-[3.4rem]">
          {messages.titleStart}{' '}
          <span class="bg-gradient-to-r from-primary to-primary/70 bg-clip-text text-transparent">
            {messages.titleHighlight}
          </span>{' '}
          {messages.titleEnd}
        </h1>
        <p class="max-w-xl text-pretty text-base text-muted-foreground sm:text-lg">{messages.subtitle}</p>
        <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
          <a href={generateHref} class="w-full sm:w-auto">
            <Button size="lg" className="w-full sm:w-auto">{messages.primaryCta}</Button>
          </a>
          <a href={studioHref} class="w-full sm:w-auto">
            <Button size="lg" variant="outline" className="w-full sm:w-auto">{messages.secondaryCta}</Button>
          </a>
        </div>
        <div class="flex w-fit max-w-full flex-wrap items-center gap-3">
          <a
            href={releasesHref}
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-4 py-2.5 text-sm font-medium transition-colors hover:border-primary/40 hover:text-foreground"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
              <path d="M7 10l5 5 5-5" />
              <path d="M12 15V3" />
            </svg>
            {messages.downloadCta}
          </a>
          <span class="text-xs text-muted-foreground">{messages.platforms}</span>
        </div>
      </div>

      <div class="relative">
        <TerminalDemo client:load messages={{
          terminalTitle: messages.terminalTitle,
          domainTab: messages.domainTab,
          codeTab: messages.codeTab,
          treeTab: messages.treeTab,
          running: messages.running,
          ready: messages.ready
        }} />
      </div>
    </div>
  </div>
</section>
