---
interface Props {
  index: number;
}

const { index } = Astro.props;
const s = 'var(--color-primary)';
---

<span class="grid size-10 place-items-center rounded-lg bg-primary/10 text-primary">
  {
    index === 0 && (
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke={s} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
        <path d="M14 2v4a2 2 0 0 0 2 2h4" />
      </svg>
    )
  }
  {
    index === 1 && (
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke={s} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1 1 0 0 1 1.52 0C14.5 3.8 17 5 19 5a1 1 0 0 1 1 1z" />
        <path d="m9 12 2 2 4-4" />
      </svg>
    )
  }
  {
    index === 2 && (
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke={s} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m16 18 6-6-6-6" />
        <path d="m8 6-6 6 6 6" />
      </svg>
    )
  }
</span>