---
import type { ProblemMessages } from '../../i18n/messages/types';
import SectionHeading from './SectionHeading.astro';

interface Props {
  messages: ProblemMessages;
}

const { messages } = Astro.props;
---

<section id="problem" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-24 sm:px-6">
  <SectionHeading
    eyebrow={messages.eyebrow}
    titleStart={messages.titleStart}
    titleHighlight={messages.titleHighlight}
    titleEnd={messages.titleEnd}
    subtitle={messages.subtitle}
  />

  <div class="mt-14 overflow-hidden rounded-xl border border-border">
    <div class="grid grid-cols-1 sm:grid-cols-2">
      <div class="bg-muted/40 px-6 py-4 text-sm font-semibold">{messages.headerTraditional}</div>
      <div class="border-t border-border bg-primary/5 px-6 py-4 text-sm font-semibold text-primary sm:border-t-0 sm:border-l">
        {messages.headerDomaincraft}
      </div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2">
      {
        messages.rows.map((row) => (
          <>
            <div class="flex items-start gap-3 border-t border-border px-6 py-5 sm:border-r">
              <span class="mt-0.5 size-5 shrink-0 rounded-full bg-muted text-center font-mono text-xs leading-5 text-muted-foreground">
                ×
              </span>
              <p class="text-sm text-muted-foreground">{row.traditional}</p>
            </div>
            <div class="flex items-start gap-3 border-t border-border bg-primary/5 px-6 py-5 sm:border-l">
              <span class="mt-0.5 size-5 shrink-0 rounded-full bg-primary/15 text-center font-mono text-xs leading-5 text-primary">
                ✓
              </span>
              <p class="text-sm font-medium text-foreground">{row.domaincraft}</p>
            </div>
          </>
        ))
      }
    </div>
  </div>
</section>
