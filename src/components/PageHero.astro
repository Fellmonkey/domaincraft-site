---
interface Props {
  title: string;
  lede: string;
}

const { title, lede } = Astro.props;
---

<div class="mx-auto max-w-6xl px-4 pt-16 sm:px-6">
  <h1 class="max-w-2xl text-balance text-4xl font-semibold tracking-tight sm:text-5xl">{title}</h1>
  <p class="mt-4 max-w-2xl text-balance text-lg text-muted-foreground">{lede}</p>
</div>