---
import CodeBlock from './CodeBlock.astro';

interface Props {
  lang: 'en' | 'ru';
  backLabel: string;
  title: string;
}

const { lang } = Astro.props;
const isEn = lang === 'en';

const t = {
  home: isEn ? 'Home' : 'Главная',
  install: isEn ? 'Install' : 'Установка',
  step1: isEn ? '1. Install the CLI' : '1. Установите CLI',
  step1a: isEn
    ? 'Download the binary for your platform from Releases, or build from source:'
    : 'Скачайте бинарник для вашей платформы из Releases или соберите из исходников:',
  step2: isEn ? '2. Create a project' : '2. Создайте проект',
  step2a: isEn
    ? 'The interactive wizard scaffolds a starter domain.yaml:'
    : 'Интерактивный мастер создаёт стартовый domain.yaml:',
  step3: isEn ? '3. Define your domain' : '3. Опишите домен',
  step3a: isEn ? 'Edit domain.yaml — that is all you write:' : 'Отредактируйте domain.yaml — это всё, что вы пишете:',
  step4: isEn ? '4. Generate & run' : '4. Сгенерируйте и запустите',
  step4a: isEn
    ? 'Generate the full project, then run it:'
    : 'Сгенерируйте полный проект, затем запустите:',
  done: isEn
    ? 'You now have a complete, compilable backend — entities, repositories, controllers, auth, migrations, Docker.'
    : 'У вас теперь полный компилируемый бэкенд — сущности, репозитории, контроллеры, авторизация, миграции, Docker.',
  validate: isEn ? 'Validate any domain.yaml instantly:' : 'Проверьте любой domain.yaml мгновенно:',
  copy: isEn ? 'Copy' : 'Скопировать',
  copied: isEn ? 'Copied' : 'Скопировано'
};

const codeBlocks = [
  { lang: 'sh', code: 'go install github.com/DomainCraft/DomainCraft/cmd/domaincraft@latest' },
  { lang: 'sh', code: 'domaincraft new' },
  {
    lang: 'yaml',
    code: `project:
  name: MyShop
  database: postgresql

auth:
  type: jwt
  entity: User

entities:
  Product:
    features: [audit, soft_delete]
    fields:
      id: uuid [primary]
      title: string [required, min:3, max:200]
      price: decimal [required, gte:0]
    permissions:
      read: ["*"]
      create: [Admin]
      update: ["@Owner", Admin]
`
  },
  {
    lang: 'sh',
    code: `domaincraft generate --domain domain.yaml --bridge csharp-restful
cd generated
dotnet run --project src/WebApi`
  },
  { lang: 'sh', code: 'domaincraft validate --domain domain.yaml' }
];

const steps = [
  { title: t.step1, desc: t.step1a, block: codeBlocks[0] },
  { title: t.step2, desc: t.step2a, block: codeBlocks[1] },
  { title: t.step3, desc: t.step3a, block: codeBlocks[2] },
  { title: t.step4, desc: t.step4a, block: codeBlocks[3] }
];
---

<section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
  <a href={isEn ? '/' : '/ru/'} class="text-sm text-muted-foreground transition-colors hover:text-foreground">
    ← {t.home}
  </a>
  <h1 class="mt-4 text-balance text-3xl font-semibold tracking-tight sm:text-4xl">{t.title}</h1>

  <ol class="mt-10 space-y-10">
    {
      steps.map((s) => (
        <li key={s.title}>
          <h2 class="mb-2 text-lg font-semibold">{s.title}</h2>
          <p class="mb-4 text-sm text-muted-foreground">{s.desc}</p>
          <CodeBlock lang={s.block.lang} code={s.block.code} copyLabel={t.copy} copiedLabel={t.copied} />
        </li>
      ))
    }
  </ol>

  <h2 class="mt-12 text-lg font-semibold">{t.validate}</h2>
  <div class="mt-4">
    <CodeBlock lang={codeBlocks[4].lang} code={codeBlocks[4].code} copyLabel={t.copy} copiedLabel={t.copied} />
  </div>

  <p class="mt-8 rounded-xl border border-border bg-card p-5 text-sm text-muted-foreground">{t.done}</p>
</section>