---
import type { Messages } from '../i18n/messages/types';
import Hero from './site/Hero.astro';
import TrustBar from './site/TrustBar.astro';
import Problem from './site/Problem.astro';
import HowItWorks from './site/HowItWorks.astro';
import Features from './site/Features.astro';
import AISection from './site/AISection.astro';
import StudioSection from './site/StudioSection.astro';
import Bridges from './site/Bridges.astro';
import Cta from './site/Cta.astro';

interface Props {
  lang: 'en' | 'ru';
  messages: Messages;
}

const { lang, messages } = Astro.props;
---

<Hero lang={lang} messages={messages.hero} />
<TrustBar messages={messages.trust} />
<Problem messages={messages.problem} />
<HowItWorks messages={messages.howItWorks} />
<Features messages={messages.features} />
<AISection messages={messages.ai} />
<StudioSection messages={messages.studio} />
<Bridges lang={lang} messages={messages.bridges} />
<Cta lang={lang} messages={messages.cta} />