---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import PostCard from '../../components/blog/PostCard.astro';
import { getMessages } from '../../i18n';
import { tagLabel } from '../../lib/blog';
import { withBase } from '../../lib/paths';

const messages = getMessages('ru');

const posts = (await getCollection('blog'))
  .filter((p) => p.data.lang === 'ru')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();

const title = 'Блог — DomainCraft';  const description =
    'Истории, руководства и разборы о генераторе кода и компиляторе домена DomainCraft — один domain.yaml в ASP.NET Core API, TypeScript-клиент и админку.';
---

<Layout lang="ru" title={title} description={description} messages={messages} alternatePath="/blog" alternateLabel="English">
  <PageHero
    title="Блог"
    lede="Истории, руководства и разборы — от генерации кода на основе домена до того, как устроены мосты."
  />

  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    {
      allTags.length > 0 && (
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-sm font-medium text-muted-foreground">{messages.blog.topics}:</span>
          {
            allTags.map((tag) => (
              <a
                href={withBase(`/ru/blog/tag/${tag}/`)}
                class="rounded-full border border-border bg-card px-3 py-1 text-sm text-muted-foreground transition-colors hover:border-primary/40 hover:text-foreground"
              >
                {tagLabel(tag, 'ru')}
              </a>
            ))
          }
        </div>
      )
    }
  </div>

  <div class="mx-auto max-w-6xl px-4 py-4 pb-16 sm:px-6">
    <div class="grid gap-6 sm:grid-cols-2">
      {
        posts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            href={`/ru/blog/${post.id.replace(/^ru\//, '')}/`}
            tags={post.data.tags}
            lang="ru"
            readLabel={messages.blog.read}
          />
        ))
      }
    </div>

    {
      posts.length === 0 && (
        <div class="flex flex-col items-center gap-4 rounded-xl border border-dashed border-border bg-card px-6 py-16 text-center">
          <p class="text-base font-medium">Первый пост в работе</p>
          <p class="max-w-md text-sm text-muted-foreground">
            Мы пишем о доменной модели, конвейере компилятора и экосистеме мостов. Подпишитесь или следите за репозиторием,
            чтобы не пропустить.
          </p>
          <a
            href="https://github.com/DomainCraft/DomainCraft"
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center gap-1 text-sm font-medium text-primary underline underline-offset-4 hover:underline-offset-8"
          >
            Следить на GitHub →
          </a>
        </div>
      )
    }
  </div>
</Layout>
