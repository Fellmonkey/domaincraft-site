---
import Layout from '../../layouts/Layout.astro';
import HomePage from '../../components/HomePage.astro';
import { getMessages } from '../../i18n';

const messages = getMessages('ru');

const title = 'DomainCraft — генератор кода и компилятор домена: один YAML → весь стек';
const description =
  'Бесплатный генератор кода с открытым исходником, работающий как компилятор доменной модели: один domain.yaml → продакшн-API на ASP.NET Core + PostgreSQL с авторизацией, типизированный TypeScript-клиент и админка — из единой модели.';
---

<Layout
  lang="ru"
  title={title}
  description={description}
  messages={messages}
  alternatePath="/"
  alternateLabel="English"
>
  <HomePage lang="ru" messages={messages} />
</Layout>