---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { getMessages } from '../../i18n';

const messages = getMessages('ru');

const skills = [
  {
    name: 'domaincraft-core',
    description:
      'Контракт доменной модели для ИИ-агентов. Загружается при моделировании домена, написании или правке domain.yaml и при добавлении бизнес-логики в сгенерированные сущности — заранее объясняет контракт и границы допустимого.'
  },
  {
    name: 'domaincraft-csharp',
    description:
      'Работа с кодом моста csharp-rest — ASP.NET Core REST API (EF Core + PostgreSQL + JWT). Бизнес-логика в кастомных partial, никогда в *.g.cs. Всегда загружается вместе с domaincraft-core.'
  },
  {
    name: 'domaincraft-ts',
    description:
      'Фреймворк-независимый TypeScript-слой данных: типы чтения, Zod-схемы, типизированный query DSL, JWT-клиент, ошибки и матрица прав.'
  },
  {
    name: 'domaincraft-react',
    description:
      'React-слой над ts-core: хуки TanStack Query с оптимистичными обновлениями и рецепты экранов поверх типизированного клиента.'
  },
  {
    name: 'validate-first',
    description:
      'Перед каждой генерацией — domaincraft validate. Исправлять ровно описанную ошибку, по одной правке на прогон.'
  },
  {
    name: 'hook-authoring',
    description:
      'Где живёт бизнес-логика: кастомные файлы overwrite:false и C#-хуки Generation Gap, которые переживают регенерацию.'
  },
  {
    name: 'safe-rename',
    description:
      'Переименования сущностей и полей через old_name + --prune: кастомные файлы и колонки БД сохраняют данные.'
  },
  {
    name: 'dc-init',
    description:
      'Команда /dc-init: старт сценария shop, saas, crm или blog через domaincraft init, затем validate и generate.'
  }
];

const title = 'Скиллы — DomainCraft';
const description =
  'Готовые скиллы для агентов, чтобы Cursor, Claude Code и Copilot могли моделировать, валидировать и расширять проект DomainCraft из коробки.';
---

<Layout lang="ru" title={title} description={description} messages={messages} alternatePath="/skills" alternateLabel="English">
  <PageHero
    title="Скиллы"
    lede="Специальные скиллы позволяют ИИ-ассистентам корректно работать с проектом DomainCraft — моделировать домен, валидировать domain.yaml и расширять сгенерированный код, не нарушая контракт."
  />

  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-5 sm:grid-cols-2">
      {
        skills.map((s) => (
          <article class="rounded-xl border border-border bg-card p-6">
            <h2 class="font-mono text-base font-semibold">{s.name}</h2>
            <p class="mt-3 text-sm text-muted-foreground">{s.description}</p>
          </article>
        ))
      }
    </div>

    <div class="mt-10 rounded-xl border border-border bg-card p-5">
      <h2 class="font-semibold">Установка</h2>
      <p class="mt-2 text-sm text-muted-foreground">Claude Code:</p>
      <pre class="mt-2 overflow-x-auto rounded-lg bg-muted/40 p-4 font-mono text-xs"><code>claude plugin marketplace add DomainCraft/domaincraft-agent-plugins
claude plugin install domaincraft@domaincraft</code></pre>
      <p class="mt-4 text-sm text-muted-foreground">Cursor, Codex, Gemini, OpenCode и 75+ других агентов:</p>
      <pre class="mt-2 overflow-x-auto rounded-lg bg-muted/40 p-4 font-mono text-xs"><code>npx skills add DomainCraft/domaincraft-agent-plugins</code></pre>
      <p class="mt-4 text-sm text-muted-foreground">
        Скиллы подгружаются по требованию. Скиллы плагина вызываются как <code>/domaincraft:&lt;skill&gt;</code>.
      </p>
    </div>
  </div>
</Layout>