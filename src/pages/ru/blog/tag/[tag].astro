---
import { getCollection } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';
import PageHero from '../../../../components/PageHero.astro';
import PostCard from '../../../../components/blog/PostCard.astro';
import { getMessages } from '../../../../i18n';
import { tagLabel } from '../../../../lib/blog';
import { withBase } from '../../../../lib/paths';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const ru = posts.filter((p) => p.data.lang === 'ru');
  const tags = [...new Set(ru.flatMap((p) => p.data.tags))].sort();
  return tags.map((tag) => ({ params: { tag }, props: { tag } }));
}

const { tag } = Astro.props;
const messages = getMessages('ru');

const allTags = [...new Set((await getCollection('blog')).filter((p) => p.data.lang === 'ru').flatMap((p) => p.data.tags))].sort();
const posts = (await getCollection('blog'))
  .filter((p) => p.data.lang === 'ru' && p.data.tags.includes(tag))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const label = tagLabel(tag, 'ru');
const title = `${label} — Блог — DomainCraft`;
const description = `Посты о ${label.toLowerCase()} — истории и руководства команды DomainCraft: ${posts.map((p) => p.data.title).slice(0, 3).join(', ')}.`;
---

<Layout lang="ru" title={title} description={description} messages={messages} alternatePath={`/blog/tag/${tag}`} alternateLabel="English">
  <PageHero title={label} lede={`Посты о ${label.toLowerCase()} — истории, руководства и разборы команды DomainCraft.`} />

  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <div class="flex flex-wrap items-center gap-2">
      <a
        href={withBase('/ru/blog/')}
        class="rounded-full border border-border bg-card px-3 py-1 text-sm text-muted-foreground transition-colors hover:border-primary/40 hover:text-foreground"
      >
        {messages.blog.backToPosts}
      </a>
      <span class="text-sm font-medium text-muted-foreground">{messages.blog.topics}:</span>
      {
        allTags.map((t) => (
            <a
              href={withBase(`/ru/blog/tag/${t}/`)}
              class={`rounded-full border px-3 py-1 text-sm transition-colors ${
                t === tag
                  ? 'border-primary/40 bg-primary/10 font-medium text-primary'
                  : 'border-border bg-card text-muted-foreground hover:border-primary/40 hover:text-foreground'
              }`}
            >
              {tagLabel(t, 'ru')}
            </a>
          ))
      }
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-4 py-4 pb-16 sm:px-6">
    <div class="grid gap-6 sm:grid-cols-2">
      {
        posts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            href={`/ru/blog/${post.id.replace(/^ru\//, '')}/`}
            tags={post.data.tags}
            lang="ru"
            readLabel={messages.blog.read}
          />
        ))
      }
    </div>
  </div>
</Layout>