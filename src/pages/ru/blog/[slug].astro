---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Prose from '../../../components/Prose.astro';
import ReadingProgress from '../../../components/blog/ReadingProgress';
import BlogToc from '../../../components/blog/BlogToc';
import Announcement from '../../../components/blog/Announcement.astro';
import { extractTocHeadings } from '../../../lib/blog';
import { getMessages } from '../../../i18n';

interface Props {
  entry: CollectionEntry<'blog'>;
}

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const ru = posts.filter((p) => p.data.lang === 'ru').sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return ru.map((entry) => ({ params: { slug: entry.id.replace(/^ru\//, '') }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const messages = getMessages('ru');
const title = `${entry.data.title} · Блог — DomainCraft`;
const date = entry.data.date.toLocaleDateString('ru-RU', { year: 'numeric', month: 'long', day: 'numeric' });
const updated = entry.data.updated ? new Date(entry.data.updated) : undefined;
const modifiedTime = updated && !Number.isNaN(updated.getTime()) ? updated.toISOString() : undefined;

// Время чтения: считаем слова в markdown, исключая код и синтаксис разметки.
const readingBody = (entry.body ?? '')
  .replace(/```[\s\S]*?```/g, ' ') // блоки кода
  .replace(/`[^`]*`/g, ' ') // инлайн-код
  .replace(/!?\[[^\]]*\]\([^)]*\)/g, ' ') // ссылки/картинки
  .replace(/[#>*_~|\-]{1,}/g, ' ') // маркеры заголовков/списков/выделения
  .replace(/\s+/g, ' ');
const wordCount = readingBody.trim().split(' ').filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));
const tocHeadings = extractTocHeadings(entry.body ?? '');
---

<Layout
  lang="ru"
  title={title}
  description={entry.data.description}
  messages={messages}
  alternatePath={`/blog/${entry.id.replace(/^ru\//, '')}`}
  alternateLabel="English"
  ogType="article"
  publishedTime={entry.data.date.toISOString()}
  modifiedTime={modifiedTime}
>
  <ReadingProgress client:load />

  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_14rem] lg:gap-16">
      <article class="min-w-0 max-w-3xl">
        <div class="lg:hidden">
          <BlogToc client:load label={messages.blog.toc} variant="mobile" headings={tocHeadings} />
        </div>

        <p class="text-sm font-mono text-muted-foreground">
          {date} · {readingMinutes} {messages.blog.readingTime}
        </p>
        <h1 class="mt-2 text-balance text-3xl font-semibold tracking-tight sm:text-4xl">{entry.data.title}</h1>
        <p class="mt-3 text-balance text-lg text-muted-foreground">{entry.data.description}</p>

        <div class="mt-10 border-t border-border pt-10">
          <Prose>
            <Content />
          </Prose>
        </div>

        <div class="mt-12 flex flex-col gap-4 border-t border-border pt-8">
          <Announcement
            variant="community"
            title={messages.blog.communityTitle}
            body={messages.blog.communityBody}
          />
          <Announcement
            variant="brand"
            title={messages.blog.brandTitle}
            body={messages.blog.brandBody}
          />
        </div>

        <div class="mt-8">
          <a href="/ru/blog" class="text-sm font-medium text-primary underline underline-offset-4 hover:underline-offset-8">
            {messages.blog.backToPosts}
          </a>
        </div>
      </article>

      <aside class="hidden lg:block">
        <BlogToc client:load label={messages.blog.toc} variant="sidebar" headings={tocHeadings} />
      </aside>
    </div>
  </div>
</Layout>
