---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { getMessages } from '../../i18n';

const messages = getMessages('ru');

const title = 'Changelog — DomainCraft';
const description = 'Release notes для DomainCraft — что нового, исправлено и изменено в каждом релизе.';
---

<Layout lang="ru" title={title} description={description} messages={messages} alternatePath="/changelog" alternateLabel="English">
  <PageHero
    title="Changelog"
    lede="Release notes для DomainCraft — что нового, исправлено и изменено в каждом релизе."
  />

  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="flex flex-col items-center gap-4 rounded-xl border border-dashed border-border bg-card px-6 py-16 text-center">
      <p class="text-base font-medium">Релизов пока нет</p>
      <p class="max-w-md text-sm text-muted-foreground">
        Релизы выходят на GitHub. По мере выхода версий changelog будет заполняться здесь.
      </p>
      <a
        href="https://github.com/DomainCraft/DomainCraft/releases"
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center gap-1 text-sm font-medium text-primary underline underline-offset-4 hover:underline-offset-8"
      >
        GitHub Releases →
      </a>
    </div>
  </div>
</Layout>