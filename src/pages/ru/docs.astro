---
import Layout from '../../layouts/Layout.astro';
import DocsQuickstart from '../../components/DocsQuickstart.astro';
import { getMessages } from '../../i18n';

const messages = getMessages('ru');

const title = 'Документация · Быстрый старт — DomainCraft';
const description =
  'Установите DomainCraft, опишите домен в domain.yaml и сгенерируйте готовый бэкенд за считанные минуты.';
---

<Layout
  lang="ru"
  title={title}
  description={description}
  messages={messages}
  alternatePath="/docs"
  alternateLabel="English"
>
  <DocsQuickstart lang="ru" title="Быстрый старт" backLabel="Главная" />
</Layout>