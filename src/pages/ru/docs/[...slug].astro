---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { buildGroups, getPrevNext, sectionLabel, sortDocs } from '../../../lib/docs';
import type { Locale } from '../../../i18n';

interface Props {
  entry: import('astro:content').CollectionEntry<'docs'>;
}

const lang: Locale = 'ru';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  const paths = docs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
  const quickstart = docs.find((d) => d.id === 'getting-started/quickstart');
  if (quickstart) paths.push({ params: { slug: undefined }, props: { entry: quickstart } });
  return paths;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const all = await getCollection('docs');
const sorted = sortDocs(all);
const groups = buildGroups(sorted, lang);
const { prev, next } = getPrevNext(sorted, entry.id);
const title = `${entry.data.title} · Документация — DomainCraft`;
---

<DocsLayout
  lang={lang}
  title={title}
  description={entry.data.description}
  docsRoot="/ru/docs"
  groups={groups}
  currentSlug={entry.id}
  sectionLabel={sectionLabel(entry.data.section, lang)}
  prev={prev}
  next={next}
>
  <Content />
</DocsLayout>