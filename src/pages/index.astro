---
import Layout from '../layouts/Layout.astro';
import HomePage from '../components/HomePage.astro';
import { getMessages } from '../i18n';

const messages = getMessages('en');

const title = 'DomainCraft — open-source .NET backend code generator (YAML → API)';
const description =
  'Free open-source code generator. One domain.yaml → production ASP.NET Core + EF Core + PostgreSQL API with JWT auth, a typed TypeScript client and an admin panel.';
---

<Layout
  lang="en"
  title={title}
  description={description}
  messages={messages}
  alternatePath="/ru/"
  alternateLabel="Русский"
>
  <HomePage lang="en" messages={messages} />
</Layout>