---
import Layout from '../layouts/Layout.astro';
import HomePage from '../components/HomePage.astro';
import { getMessages } from '../i18n';

const messages = getMessages('en');

const title = 'DomainCraft — describe your domain once in YAML, ship production code in any language';
const description =
  'DomainCraft is a domain-driven code generator. Define your domain in a single domain.yaml and get a production-ready backend — CRUD, auth, permissions, migrations, admin — in any language, regenerated safely.';
---

<Layout
  lang="en"
  title={title}
  description={description}
  messages={messages}
  alternatePath="/ru/"
  alternateLabel="Русский"
>
  <HomePage lang="en" messages={messages} />
</Layout>