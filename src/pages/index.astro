---
import Layout from '../layouts/Layout.astro';
import HomePage from '../components/HomePage.astro';
import { getMessages } from '../i18n';

const messages = getMessages('en');

const title = 'DomainCraft — code generator & domain compiler: one YAML → full-stack code';
const description =
  'Free and open-source code generator and domain compiler. One domain.yaml → a production ASP.NET Core + PostgreSQL API with JWT auth, a typed TypeScript client and an admin panel — consistently, from a single model.';
---

<Layout
  lang="en"
  title={title}
  description={description}
  messages={messages}
  alternatePath="/ru/"
  alternateLabel="Русский"
>
  <HomePage lang="en" messages={messages} />
</Layout>