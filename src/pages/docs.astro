---
import Layout from '../layouts/Layout.astro';
import DocsQuickstart from '../components/DocsQuickstart.astro';
import { getMessages } from '../i18n';

const messages = getMessages('en');

const title = 'Documentation · Quick start — DomainCraft';
const description =
  'Install DomainCraft, define your domain in domain.yaml and generate a production-ready backend in minutes.';
---

<Layout
  lang="en"
  title={title}
  description={description}
  messages={messages}
  alternatePath="/ru/docs"
  alternateLabel="Русский"
>
  <DocsQuickstart lang="en" title="Quick start" backLabel="Home" />
</Layout>