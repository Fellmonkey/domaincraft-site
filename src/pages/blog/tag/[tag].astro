---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import PageHero from '../../../components/PageHero.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import { getMessages } from '../../../i18n';
import { tagLabel } from '../../../lib/blog';
import { withBase } from '../../../lib/paths';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const en = posts.filter((p) => p.data.lang === 'en');
  const tags = [...new Set(en.flatMap((p) => p.data.tags))].sort();
  return tags.map((tag) => ({ params: { tag }, props: { tag } }));
}

const { tag } = Astro.props;
const messages = getMessages('en');

const allTags = [...new Set((await getCollection('blog')).filter((p) => p.data.lang === 'en').flatMap((p) => p.data.tags))].sort();
const posts = (await getCollection('blog'))
  .filter((p) => p.data.lang === 'en' && p.data.tags.includes(tag))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const label = tagLabel(tag, 'en');
const title = `${label} — Blog — DomainCraft`;
const description = `Posts about ${label.toLowerCase()} — stories and guides from the DomainCraft team: ${posts.map((p) => p.data.title).slice(0, 3).join(', ')}.`;
---

<Layout lang="en" title={title} description={description} messages={messages} alternatePath={`/ru/blog/tag/${tag}`} alternateLabel="Русский">
  <PageHero title={label} lede={`Posts about ${label.toLowerCase()} — stories, guides and deep dives from the DomainCraft team.`} />

  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <div class="flex flex-wrap items-center gap-2">
      <a
        href={withBase('/blog/')}
        class="rounded-full border border-border bg-card px-3 py-1 text-sm text-muted-foreground transition-colors hover:border-primary/40 hover:text-foreground"
      >
        {messages.blog.backToPosts}
      </a>
      <span class="text-sm font-medium text-muted-foreground">{messages.blog.topics}:</span>
      {
        allTags.map((t) => (
            <a
              href={withBase(`/blog/tag/${t}/`)}
              class={`rounded-full border px-3 py-1 text-sm transition-colors ${
                t === tag
                  ? 'border-primary/40 bg-primary/10 font-medium text-primary'
                  : 'border-border bg-card text-muted-foreground hover:border-primary/40 hover:text-foreground'
              }`}
            >
              {tagLabel(t, 'en')}
            </a>
          ))
      }
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-4 py-4 pb-16 sm:px-6">
    <div class="grid gap-6 sm:grid-cols-2">
      {
        posts.map((post) => {
          const slug = post.id;
          return (
            <PostCard
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              href={`/blog/${slug}/`}
              tags={post.data.tags}
              lang="en"
              readLabel={messages.blog.read}
            />
          );
        })
      }
    </div>
  </div>
</Layout>