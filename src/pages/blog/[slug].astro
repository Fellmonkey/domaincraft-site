---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Prose from '../../components/Prose.astro';
import { getMessages } from '../../i18n';

interface Props {
  entry: CollectionEntry<'blog'>;
}

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const en = posts.filter((p) => p.data.lang === 'en').sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return en.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const messages = getMessages('en');
const title = `${entry.data.title} · Blog — DomainCraft`;
const date = entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout
  lang="en"
  title={title}
  description={entry.data.description}
  messages={messages}
  alternatePath={`/ru/blog/${entry.id}`}
  alternateLabel="Русский"
>
  <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <p class="text-sm font-mono text-muted-foreground">{date}</p>
    <h1 class="mt-2 text-balance text-3xl font-semibold tracking-tight sm:text-4xl">{entry.data.title}</h1>
    <p class="mt-3 text-balance text-lg text-muted-foreground">{entry.data.description}</p>

    <div class="mt-10 border-t border-border pt-10">
      <Prose>
        <Content />
      </Prose>
    </div>

    <div class="mt-12 border-t border-border pt-6">
      <a href="/blog" class="text-sm font-medium text-primary underline underline-offset-4 hover:underline-offset-8">
        ← All posts
      </a>
    </div>
  </div>
</Layout>
