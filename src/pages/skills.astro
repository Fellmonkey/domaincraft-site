---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { getMessages } from '../i18n';

const messages = getMessages('en');

const skills = [
  {
    name: 'domaincraft-core',
    description:
      'Domain-model contract for AI agents. Load it when modeling a domain, writing or editing domain.yaml, or attaching business logic to generated entities — it front-loads the contract and what you can and cannot touch.'
  },
  {
    name: 'domaincraft-csharp',
    description:
      'Working with code generated by the csharp-rest bridge — an ASP.NET Core REST API (EF Core + PostgreSQL + JWT). Implement business logic in custom partials, never in *.g.cs. Always loads domaincraft-core alongside.'
  },
  {
    name: 'domaincraft-ts',
    description:
      'The framework-agnostic TypeScript data layer: read projections, Zod schemas, the typed query DSL, JWT client, error taxonomy and the permissions matrix.'
  },
  {
    name: 'domaincraft-react',
    description:
      'React glue over ts-core: TanStack Query hooks with optimistic updates and the UI recipes for building screens against the typed client.'
  },
  {
    name: 'validate-first',
    description:
      'Run domaincraft validate before every generate. Fix exactly the reported error, one fix per validation run.'
  },
  {
    name: 'hook-authoring',
    description:
      'Where business logic lives: overwrite:false custom files and the C# Generation Gap hooks that survive regeneration.'
  },
  {
    name: 'safe-rename',
    description:
      'Entity and field renames with old_name plus --prune, so custom files and database columns keep their data.'
  },
  {
    name: 'dc-init',
    description:
      'The /dc-init command: bootstrap shop, saas, crm or blog with domaincraft init, then validate and generate.'
  }
];

const title = 'Skills — DomainCraft';
const description =
  'Ready-made agent skills so Cursor, Claude Code and Copilot can model, validate and extend a DomainCraft project out of the box.';
---

<Layout lang="en" title={title} description={description} messages={messages} alternatePath="/ru/skills" alternateLabel="Русский">
  <PageHero
    title="Skills"
    lede="Dedicated agent skills let AI assistants work with a DomainCraft project correctly — modeling the domain, validating domain.yaml and extending generated code without breaking the contract."
  />

  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-5 sm:grid-cols-2">
      {
        skills.map((s) => (
          <article class="rounded-xl border border-border bg-card p-6">
            <h2 class="font-mono text-base font-semibold">{s.name}</h2>
            <p class="mt-3 text-sm text-muted-foreground">{s.description}</p>
          </article>
        ))
      }
    </div>

    <div class="mt-10 rounded-xl border border-border bg-card p-5">
      <h2 class="font-semibold">Install</h2>
      <p class="mt-2 text-sm text-muted-foreground">Claude Code:</p>
      <pre class="mt-2 overflow-x-auto rounded-lg bg-muted/40 p-4 font-mono text-xs"><code>claude plugin marketplace add DomainCraft/domaincraft-agent-plugins
claude plugin install domaincraft@domaincraft</code></pre>
      <p class="mt-4 text-sm text-muted-foreground">Cursor, Codex, Gemini, OpenCode and 75+ other agents:</p>
      <pre class="mt-2 overflow-x-auto rounded-lg bg-muted/40 p-4 font-mono text-xs"><code>npx skills add DomainCraft/domaincraft-agent-plugins</code></pre>
      <p class="mt-4 text-sm text-muted-foreground">
        Skills load on demand. Plugin skills are invoked as <code>/domaincraft:&lt;skill&gt;</code>.
      </p>
    </div>
  </div>
</Layout>