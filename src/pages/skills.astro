---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { getMessages } from '../i18n';

const messages = getMessages('en');

const skills = [
  {
    name: 'domaincraft-core',
    description:
      'Domain-model contract for AI agents. Load it when modeling a domain, writing or editing domain.yaml, or attaching business logic to generated entities — it front-loads the contract and what you can and cannot touch.'
  },
  {
    name: 'domaincraft-csharp',
    description:
      'Working with code generated by the csharp-rest bridge — an ASP.NET Core REST API (EF Core + PostgreSQL + JWT). Implement business logic in the generated services, or extend *.g.cs vs custom partials. Always loads domaincraft-core alongside.'
  }
];

const title = 'Skills — DomainCraft';
const description =
  'Ready-made agent skills so Cursor, Claude Code and Copilot can model, validate and extend a DomainCraft project out of the box.';
---

<Layout lang="en" title={title} description={description} messages={messages} alternatePath="/ru/skills" alternateLabel="Русский">
  <PageHero
    title="Skills"
    lede="Dedicated agent skills let AI assistants work with a DomainCraft project correctly — modeling the domain, validating domain.yaml and extending generated code without breaking the contract."
  />

  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-5 sm:grid-cols-2">
      {
        skills.map((s) => (
          <article class="rounded-xl border border-border bg-card p-6">
            <h2 class="font-mono text-base font-semibold">{s.name}</h2>
            <p class="mt-3 text-sm text-muted-foreground">{s.description}</p>
          </article>
        ))
      }
    </div>

    <p class="mt-10 rounded-xl border border-border bg-card p-5 text-sm text-muted-foreground">
      Skills are loaded by your agent on demand. To install them, follow the skills guide for your assistant — Cursor,
      Claude Code or Copilot.
    </p>
  </div>
</Layout>