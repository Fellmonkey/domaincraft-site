---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { getMessages } from '../i18n';
import { withBase } from '../lib/paths';

const messages = getMessages('en');

const bridges = [
  {
    id: 'csharp-rest',
    language: 'C#',
    status: 'ready',
    description: 'ASP.NET Core + EF Core + PostgreSQL + JWT + Clean Architecture (core → domain → efcore → rest)'
  },
  {
    id: 'csharp-core',
    language: 'C#',
    status: 'ready',
    description: 'Thin language core — enum wire values, entity types, query schema'
  },
  {
    id: 'ts-core',
    language: 'TypeScript',
    status: 'ready',
    description: 'Thin language core — typed query DSL, permissions, wire values'
  },
  {
    id: 'ts-client',
    language: 'TypeScript',
    status: 'ready',
    description: 'Zod validation, JWT fetch client, per-entity CRUD (extends ts-core)'
  },
  {
    id: 'react-rest',
    language: 'TypeScript',
    status: 'ready',
    description: 'React glue (extends ts-client) — TanStack Query hooks, typed filters, auth'
  },
  {
    id: 'admin-alpine',
    language: 'HTML',
    status: 'ready',
    description: 'Admin panel with Alpine.js + 0build UIkit — CRUD for any REST backend'
  },
  {
    id: 'appwrite',
    language: 'JSON',
    status: 'ready',
    description: 'Appwrite schema: TablesDB + role teams + settings, deployed via the Appwrite CLI'
  }
];

const title = 'Code generator bridges — DomainCraft axes & layers';
const description =
  'Code generator bridges: per-language cores and role layers that compose C#, TypeScript and beyond from one domain. See what is available and how to add your own.';
---

<Layout lang="en" title={title} description={description} messages={messages} alternatePath="/ru/bridges" alternateLabel="Русский">
  <PageHero
    title="Bridges"
    lede="Each bridge is one layer in one axis: a thin certified core plus role layers on top. `extends` builds the chain, `--replace` swaps a layer — no forks; every layer is a bridge in the same repository."
  />

  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-5 sm:grid-cols-2">
      {
        bridges.map((b) => (
          <article class="rounded-xl border border-border bg-card p-6">
            <div class="flex items-center justify-between gap-3">
              <h2 class="font-mono text-base font-semibold">{b.id}</h2>
              <span class="rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary">{b.status}</span>
            </div>
            <p class="mt-1 font-mono text-xs text-muted-foreground">{b.language}</p>
            <p class="mt-3 text-sm text-muted-foreground">{b.description}</p>
          </article>
        ))
      }
    </div>

    <p class="mt-5 text-sm text-muted-foreground">
      Planned: <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs">csharp-dapper</code> (persistence),
      <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs">csharp-grpc</code> (transport) and{' '}
      <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs">vue-rest</code> /{' '}
      <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs">svelte-rest</code> (thin adapters over ts-client).
    </p>

    <div class="mt-12 grid grid-cols-1 gap-10 lg:grid-cols-2">
      <div>
        <h2 class="text-lg font-semibold">Use a bridge</h2>
        <p class="mt-2 text-sm text-muted-foreground">
          Resolve by registry ID, local path or GitHub shorthand. The CLI clones known bridges on demand into
          <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs">~/.domaincraft/bridges/</code>.
        </p>
        <pre class="mt-4 overflow-x-auto rounded-xl border border-border bg-card p-4 font-mono text-[13px] leading-relaxed">{`# By registry ID
domaincraft generate --domain domain.yaml --bridge csharp-rest

# By local path
domaincraft generate --domain domain.yaml --bridge csharp-rest

# Swap one layer (Dapper persistence instead of EF Core)
domaincraft generate --domain domain.yaml --bridge csharp-rest --replace persistence=csharp-dapper

# With an admin panel (default admin-alpine)
domaincraft generate --domain domain.yaml --bridge csharp-rest --admin`}</pre>
      </div>
      <div>
        <h2 class="text-lg font-semibold">Add your own</h2>
        <p class="mt-2 text-sm text-muted-foreground">
          A bridge is just templates and a manifest — no Go code required. Append an entry to the core registry and
          write a <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs">bridge.yaml</code> plus your templates.
        </p>
        <a
          href={withBase('/docs/guides/writing-a-bridge')}
          class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-primary underline underline-offset-4 hover:underline-offset-8"
        >
          Read the writing-a-bridge guide →
        </a>
      </div>
    </div>
  </div>
</Layout>