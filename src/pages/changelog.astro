---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { getMessages } from '../i18n';

const messages = getMessages('en');

const title = 'Changelog — DomainCraft';
const description = 'Release notes for DomainCraft — what is new, fixed and changed in every release.';
---

<Layout lang="en" title={title} description={description} messages={messages} alternatePath="/ru/changelog" alternateLabel="Русский">
  <PageHero
    title="Changelog"
    lede="Release notes for DomainCraft — what is new, fixed and changed in every release."
  />

  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="flex flex-col items-center gap-4 rounded-xl border border-dashed border-border bg-card px-6 py-16 text-center">
      <p class="text-base font-medium">No releases published yet</p>
      <p class="max-w-md text-sm text-muted-foreground">
        Releases land on GitHub. The changelog will be filled here as versions ship.
      </p>
      <a
        href="https://github.com/DomainCraft/DomainCraft/releases"
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center gap-1 text-sm font-medium text-primary underline underline-offset-4 hover:underline-offset-8"
      >
        GitHub Releases →
      </a>
    </div>
  </div>
</Layout>